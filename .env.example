# Copy to .env and replace every CHANGE_ME value before launching.
MYSQL_DATABASE=research_profiles
MYSQL_USER=research
MYSQL_PASSWORD=CHANGE_ME_LONG_MYSQL_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_LONG_ROOT_PASSWORD
DJANGO_SECRET_KEY=CHANGE_ME_RANDOM_50_PLUS_CHARACTERS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
BOOTSTRAP_ADMIN_USERNAME=admin_nckh
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_LONG_INITIAL_ADMIN_PASSWORD
WEB_BIND=127.0.0.1
WEB_PORT=8080
COOKIE_SECURE=0
DJANGO_CSRF_TRUSTED_ORIGINS=

# Khóa Fernet 32-byte base64 dùng mã hóa khóa ký nội bộ. Tạo bằng:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTERNAL_SIGNING_MASTER_KEY=CHANGE_ME_FERNET_KEY
